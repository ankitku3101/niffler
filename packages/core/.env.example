# Postgres. This default matches docker-compose.yml.
DATABASE_URL=postgres://niffler:niffler@localhost:5433/niffler

# The LLM providers. Groq is primary, Gemini takes over on a rate limit.
# Both have free tiers that are enough to run this.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional. These are the defaults if you leave them blank.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash

# Razorpay Test Mode, from the dashboard's API Keys page.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set when you register a webhook. The API refuses to start without it,
# so put any value here if you are not testing webhooks yet.
RAZORPAY_WEBHOOK_SECRET=

# Optional. Skips the public run cooldown; visit the dashboard with ?owner=<value>.
OWNER_BYPASS_TOKEN=

# Optional. In production, set this to your frontend URL to lock down CORS.
# WEB_ORIGIN=
